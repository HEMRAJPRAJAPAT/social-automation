# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database (Postgres via Prisma)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://reel_user:reel_password@localhost:5432/reel_automation?schema=public

# ---------------------------------------------------------------------------
# Scheduler
# ---------------------------------------------------------------------------
# Standard 5-field cron expression, evaluated in TIMEZONE below.
# Default: every day at 09:00.
CRON=0 9 * * *
TIMEZONE=UTC
# Set to "true" to also run the pipeline once immediately on process boot.
RUN_ON_STARTUP=false

# ---------------------------------------------------------------------------
# Content configuration (drives the Topic Planner / Script Generator)
# ---------------------------------------------------------------------------
CONTENT_NICHE=AI for Developers
CONTENT_LANGUAGE=en
CONTENT_POSTING_FREQUENCY=daily
CONTENT_VIDEO_DURATION_SECONDS=30
CONTENT_WRITING_STYLE=friendly, concise, expert but approachable

# ---------------------------------------------------------------------------
# Gemini (Google AI Studio - free tier)
# https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-flash-latest
GEMINI_TTS_MODEL=
# "espeak" (free, offline, default) or "gemini" (requires GEMINI_TTS_MODEL + TTS access)
VOICE_PROVIDER=espeak

# ---------------------------------------------------------------------------
# Stock media providers (free tiers)
# ---------------------------------------------------------------------------
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ---------------------------------------------------------------------------
# Instagram Graph API (Meta for Developers)
# ---------------------------------------------------------------------------
INSTAGRAM_ACCESS_TOKEN=
PAGE_ID=
BUSINESS_ACCOUNT_ID=
INSTAGRAM_GRAPH_API_VERSION=v20.0
# Set to "false" to render Reels end-to-end without actually uploading to
# Instagram — useful for local testing. Defaults to "true".
PUBLISH_ENABLED=true

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# "local" is the only free-tier option supported out of the box; the
# StorageProvider interface allows plugging in S3/Cloudinary/etc. later.
STORAGE_PROVIDER=local
STORAGE_ROOT=./storage
PUBLIC_BASE_URL=http://localhost:3000/media

# ---------------------------------------------------------------------------
# Retry policy (applies to all outbound HTTP calls via the retry utility)
# ---------------------------------------------------------------------------
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=1000

# ---------------------------------------------------------------------------
# Video composition
# ---------------------------------------------------------------------------
# Optional path to a royalty-free .mp3/.wav track mixed under the narration at
# low volume. Leave blank to render with narration-only audio.
BACKGROUND_MUSIC_PATH=
