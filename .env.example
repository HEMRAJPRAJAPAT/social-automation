# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database (Postgres via Prisma)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://reel_user:reel_password@localhost:5432/reel_automation?schema=public

# ---------------------------------------------------------------------------
# Scheduler
# ---------------------------------------------------------------------------
# Standard 5-field cron expression, evaluated in TIMEZONE below.
# Default: every day at 09:00.
CRON=0 9 * * *
TIMEZONE=UTC
# Set to "true" to also run the pipeline once immediately on process boot.
RUN_ON_STARTUP=false

# ---------------------------------------------------------------------------
# Content configuration (drives the Topic Planner / Script Generator)
# ---------------------------------------------------------------------------
CONTENT_NICHE=AI for Developers
CONTENT_LANGUAGE=en
CONTENT_POSTING_FREQUENCY=daily
CONTENT_VIDEO_DURATION_SECONDS=30
CONTENT_WRITING_STYLE=friendly, concise, expert but approachable
# "beginner" | "intermediate" | "advanced" — drives how much jargon/assumed
# background knowledge TopicPlanner and ScriptGenerator are allowed to use.
CONTENT_AUDIENCE_LEVEL=beginner
# Minimum ContentEvaluator overall score (0-10) before a script ships as-is.
CONTENT_QUALITY_THRESHOLD=7
# How many times to regenerate a script if it scores below the threshold
# before giving up and shipping the best-scoring attempt.
CONTENT_QUALITY_MAX_RETRIES=2
# "bold-highlight" (large text, progressive keyword highlight) or "clean-white"
CAPTION_STYLE_PRESET=bold-highlight
# "slow" | "normal" | "fast" narration pace
VOICE_SPEED=normal
# Optional free-text delivery hint for voice providers that support it (Gemini
# TTS folds this into its style instruction). Leave blank to use the default.
VOICE_STYLE=
# Fontconfig family used for burned-in captions and diagram-card text. The
# Docker image installs fonts-dejavu-core to guarantee this resolves; on a
# machine without it, ffmpeg/libass fall back to any available font instead
# of failing.
VIDEO_FONT_FAMILY=DejaVu Sans

# ---------------------------------------------------------------------------
# Gemini (Google AI Studio - free tier)
# https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-flash-latest
GEMINI_TTS_MODEL=
# "espeak" (free, offline, default) or "gemini" (requires GEMINI_TTS_MODEL + TTS access)
VOICE_PROVIDER=espeak

# ---------------------------------------------------------------------------
# Stock media providers (free tiers)
# ---------------------------------------------------------------------------
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ---------------------------------------------------------------------------
# Instagram Graph API (Meta for Developers)
# ---------------------------------------------------------------------------
INSTAGRAM_ACCESS_TOKEN=
PAGE_ID=
BUSINESS_ACCOUNT_ID=
INSTAGRAM_GRAPH_API_VERSION=v20.0
# Set to "false" to render Reels end-to-end without actually uploading to
# Instagram — useful for local testing. Defaults to "true".
PUBLISH_ENABLED=true

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# "local" is the only free-tier option supported out of the box; the
# StorageProvider interface allows plugging in S3/Cloudinary/etc. later.
STORAGE_PROVIDER=local
STORAGE_ROOT=./storage
PUBLIC_BASE_URL=http://localhost:3000/media

# ---------------------------------------------------------------------------
# Retry policy (applies to all outbound HTTP calls via the retry utility)
# ---------------------------------------------------------------------------
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=1000

# ---------------------------------------------------------------------------
# Video composition
# ---------------------------------------------------------------------------
# Optional path to a royalty-free .mp3/.wav track mixed under the narration at
# low volume. Leave blank to render with narration-only audio.
BACKGROUND_MUSIC_PATH=
